---
layout: base.njk
---
<article>
  <div class="mx-auto max-w-5xl w-full">
    <div class="max-w-3xl mx-auto">
    <header>
      <a href="{{ '/blog/' | url }}" class="inline-flex items-center text-xs text-fg-3 no-underline hover:text-fg-1 transition-colors mb-4">
        ← Back to Blog
      </a>
      <h1 class="mb-6">{{ title }}</h1>
      {% if description %}<p class="text-fg-2 mt-6 mb-8 text-base md:text-lg leading-snug">{{ description }}</p>{% endif %}
      <div class="text-sm flex flex-wrap gap-x-10 gap-y-2 border-t border-b border-line py-4 mt-8 mb-12">
        {% if author %}
        <div>
          <div class="text-xs uppercase tracking-wide text-fg-4 mb-0.5 font-mono">Author</div>
          <span class="text-fg-2">{{ author }}</span>
        </div>
        {% endif %}
        <div>
          <div class="text-xs uppercase tracking-wide text-fg-4 mb-0.5 font-mono">Published</div>
          <time class="text-fg-2">{{ date | dateFormat }}</time>
        </div>
        {% if updated %}
        <div>
          <div class="text-xs uppercase tracking-wide text-fg-4 mb-0.5 font-mono">Updated</div>
          <time class="text-fg-2">{{ updated | dateFormat }}</time>
        </div>
        {% endif %}
      </div>
    </header>
    {% if heroImage %}
    <figure class="article-hero">
      <img src="{{ heroImage }}" alt="{{ heroImageAlt or title }}" loading="lazy">
    </figure>
    {% endif %}
    <div class="prose">
      {% if sourceUrl %}
      {{ content | normalizeImportedRichText | safe }}
      {% else %}
      {{ content | safe }}
      {% endif %}
    </div>
    </div>
  </div>
</article>
